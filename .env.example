# Copy to .env.local and fill in from Supabase → Project Settings → API.
# See README.md "Set up a Supabase project" for the full setup, including the
# Auth settings (confirm email, redirect URLs, CAPTCHA) that must be on before
# anyone signs up.
# Do NOT commit .env.local or the service-role key (this app never needs it).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
