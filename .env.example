# Copy to .env.local and fill in from Supabase → Project Settings → API
# Do NOT commit .env.local or the service-role key.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Demo auth users are created with: node scripts/setup-demo-auth.mjs
# DEMO_PASSWORD is required (12+ chars, unique to you); there is no default.

# Optional: show the destructive "Reset demo data" button to admins (demo projects only).
# NEXT_PUBLIC_ENABLE_DEMO_RESET=true
